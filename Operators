#include <iostream>
#include <cmath> // For abs()

class Date {
private:
    int day, month, year;

    bool isLeapYear(int y) const {
        return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
    }

    int lastDay(int m, int y) const {
        const int daysInMonth[] = { 0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
        return (m == 2 && isLeapYear(y)) ? 29 : daysInMonth[m];
    }

public:
    // Default constructor
    Date(int m = 1, int d = 1, int y = 2000) { setDate(m, d, y); }

    // Set Date with validation
    bool setDate(int m, int d, int y) {
        if (m < 1 || m > 12 || d < 1 || d > lastDay(m, y) || y < 1) {
            std::cerr << "Invalid date!" << std::endl;
            return false;
        }
        month = m;
        day = d;
        year = y;
        return true;
    }

    // Prefix increment (++) operator
    Date& operator++() {
        if (day == lastDay(month, year)) {
            day = 1;
            month = (month == 12) ? 1 : month + 1;
            if (month == 1) year++;
        } else {
            day++;
        }
        return *this;
    }

    // Postfix increment (++) operator
    Date operator++(int) {
        Date temp = *this;
        ++(*this);
        return temp;
    }

    // Prefix decrement (--) operator
    Date& operator--() {
        if (day == 1) {
            month = (month == 1) ? 12 : month - 1;
            if (month == 12) year--;
            day = lastDay(month, year);
        } else {
            day--;
        }
        return *this;
    }

    // Postfix decrement (--) operator
    Date operator--(int) {
        Date temp = *this;
        --(*this);
        return temp;
    }

    // Subtraction operator (days between two dates)
    int operator-(const Date& other) const {
        int totalDaysThis = day, totalDaysOther = other.day;

        // Add days from previous months of the current year
        for (int m = 1; m < month; m++) totalDaysThis += lastDay(m, year);
        for (int m = 1; m < other.month; m++) totalDaysOther += lastDay(m, other.year);

        // Add days from previous years
        for (int y = 1; y < year; y++) totalDaysThis += isLeapYear(y) ? 366 : 365;
        for (int y = 1; y < other.year; y++) totalDaysOther += isLeapYear(y) ? 366 : 365;

        return std::abs(totalDaysThis - totalDaysOther);
    }

    // Output operator (<<)
    friend std::ostream& operator<<(std::ostream& out, const Date& d) {
        const std::string months[] = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
        out << months[d.month] << " " << d.day << ", " << d.year;
        return out;
    }

    // Input operator (>>)
    friend std::istream& operator>>(std::istream& in, Date& d) {
        int m, d_, y;
        char slash;
        in >> m >> slash >> d_ >> slash >> y;
        if (!d.setDate(m, d_, y)) {
            std::cerr << "Invalid input. Resetting to default (1/1/2000)." << std::endl;
            d.setDate(1, 1, 2000);
        }
        return in;
    }
};

int main() {
    Date d1;  // Default constructor
    std::cout << "Default constructor: " << d1 << "\n";
    
    Date d2(4, 10, 2014);  // Constructor with parameters
    std::cout << "Constructor with parameters: " << d2 << "\n";
    
    d2.setDate(5, 20, 2020);  // Set a valid date
    std::cout << "Set valid date: " << d2 << "\n";
    
    d2.setDate(13, 45, 2018);  // Invalid date (testing)
    d2.setDate(4, 31, 2000);   // Invalid date (testing)
    d2.setDate(2, 29, 2009);   // Invalid date (testing)
    
    Date d3(4, 18, 2014);  // Another date for testing subtraction
    std::cout << "Days between 4/10/2014 and 4/18/2014: " << (d3 - d2) << " days\n";  // Subtraction
    
    d2.setDate(2, 29, 2008);
    std::cout << "Original date: " << d2 << "\n";
    --d2;  // Pre-decrement
    std::cout << "After pre-decrement: " << d2 << "\n";
    ++d2;  // Pre-increment
    std::cout << "After pre-increment: " << d2 << "\n";
    
    d2--;  // Post-decrement
    std::cout << "After post-decrement: " << d2 << "\n";
    d2++;  // Post-increment
    std::cout << "After post-increment: " << d2 << "\n";
    
    Date d4(12, 31, 2024);  // Set date to Dec 31, 2024
    d4++;  // Post-increment (test transition to next year)
    std::cout << "After post-increment: " << d4 << "\n";
    d4--;  // Post-decrement (back to Dec 31, 2024)
    std::cout << "After post-decrement: " << d4 << "\n";
    
    std::cout << "Enter a new date (MM/DD/YYYY): ";
    std::cin >> d4;  // User input for date
    std::cout << "You entered: " << d4 << "\n";

    return 0;
}


   
       
    
   
   



   
   
   
   
