#include <iostream>
#include <cmath> // For abs()

class Date {
private:
    int day, month, year;

    // Helper function to check if a year is a leap year
    bool isLeapYear(int y) const {
        return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
    }

    // Helper function to get last day of a month
    int lastDay(int m, int y) const {
        const int daysInMonth[] = { 0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
        return (m == 2 && isLeapYear(y)) ? 29 : daysInMonth[m];
    }

    // Helper function to convert date to total days (for subtraction)
    int convertToDays() const {
        int total = day;
        for (int y = 1; y < year; y++) {
            total += isLeapYear(y) ? 366 : 365;
        }
        for (int m = 1; m < month; m++) {
            total += lastDay(m, year);
        }
        return total;
    }

public:
    // Constructor
    Date(int m = 1, int d = 1, int y = 2000) {
        setDate(m, d, y);
    }

    // Function to validate and set date
    bool setDate(int m, int d, int y) {
        if (m < 1 || m > 12 || d < 1 || d > lastDay(m, y) || y < 1) {
            std::cerr << "Invalid date!" << std::endl;
            return false;
        }
        month = m;
        day = d;
        year = y;
        return true;
    }

    // Prefix increment (++d)
    Date& operator++() {
        if (day == lastDay(month, year)) {
            day = 1;
            if (month == 12) {
                month = 1;
                year++;
            } else {
                month++;
            }
        } else {
            day++;
        }
        return *this;
    }

    // Postfix increment (d++)
    Date operator++(int) {
        Date temp = *this;
        ++(*this);
        return temp;
    }

    // Prefix decrement (--d)
    Date& operator--() {
        if (day == 1) {
            if (month == 1) {
                month = 12;
                year--;
            } else {
                month--;
            }
            day = lastDay(month, year);
        } else {
            day--;
        }
        return *this;
    }

    // Postfix decrement (d--)
    Date operator--(int) {
        Date temp = *this;
        --(*this);
        return temp;
    }

    // Subtracting two Date objects (returns days between them)
    int operator-(const Date& other) const {
        return std::abs(convertToDays() - other.convertToDays());
    }

    // Output stream operator (<<) for printing dates
    friend std::ostream& operator<<(std::ostream& out, const Date& d) {
        const std::string months[] = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
        out << months[d.month] << " " << d.day << ", " << d.year;
        return out;
    }

    // Input stream operator (>>) for reading dates
    friend std::istream& operator>>(std::istream& in, Date& d) {
        int m, d_, y;
        char slash;
        in >> m >> slash >> d_ >> slash >> y;
        if (!d.setDate(m, d_, y)) {
            std::cerr << "Invalid input. Resetting to default (1/1/2000)." << std::endl;
            d.setDate(1, 1, 2000);
        }
        return in;
    }
};

// Main function for testing
int main() {
    Date d1(12, 31, 2024);
    std::cout << "Original date: " << d1 << std::endl;

    d1++; // Post-increment
    std::cout << "After post-increment: " << d1 << std::endl;

    --d1; // Pre-decrement
    std::cout << "After pre-decrement: " << d1 << std::endl;

    Date d2(4, 10, 2014);
    Date d3(4, 18, 2014);
    std::cout << "Days between: " << (d3 - d2) << " days" << std::endl;

    std::cout << "Enter a date (MM/DD/YYYY): ";
    Date d4;
    std::cin >> d4;
    std::cout << "You entered: " << d4 << std::endl;

    return 0;
}



   
   
   
