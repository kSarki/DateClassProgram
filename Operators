#include <iostream>
#include <cmath> // For abs()

class Date {
private:
    int day, month, year;

    bool isLeapYear(int y) const {
        return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
    }

    int lastDay(int m, int y) const {
        const int daysInMonth[] = { 0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
        return (m == 2 && isLeapYear(y)) ? 29 : daysInMonth[m];
    }

    int convertToDays() const {
        int total = day;
        for (int y = 1; y < year; y++) {
            total += isLeapYear(y) ? 366 : 365;
        }
        for (int m = 1; m < month; m++) {
            total += lastDay(m, year);
        }
        return total;
    }

public:
    Date(int m = 1, int d = 1, int y = 2000) { setDate(m, d, y); }

    bool setDate(int m, int d, int y) {
        if (m < 1 || m > 12 || d < 1 || d > lastDay(m, y) || y < 1) {
            std::cerr << "Invalid date!" << std::endl;
            return false;
        }
        month = m;
        day = d;
        year = y;
        return true;
    }

    Date& operator++() {
        if (day == lastDay(month, year)) {
            day = 1;
            if (month == 12) {
                month = 1;
                year++;
            } else {
                month++;
            }
        } else {
            day++;
        }
        return *this;
    }

    Date operator++(int) {
        Date temp = *this;
        ++(*this);
        return temp;
    }

    Date& operator--() {
        if (day == 1) {
            if (month == 1) {
                month = 12;
                year--;
            } else {
                month--;
            }
            day = lastDay(month, year);
        } else {
            day--;
        }
        return *this;
    }

    Date operator--(int) {
        Date temp = *this;
        --(*this);
        return temp;
    }

    int operator-(const Date& other) const {
        return std::abs(convertToDays() - other.convertToDays());
    }

    friend std::ostream& operator<<(std::ostream& out, const Date& d) {
        const std::string months[] = { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
        out << months[d.month] << " " << d.day << ", " << d.year;
        return out;
    }

    friend std::istream& operator>>(std::istream& in, Date& d) {
        int m, d_, y;
        char slash;
        in >> m >> slash >> d_ >> slash >> y;
        if (!d.setDate(m, d_, y)) {
            std::cerr << "Invalid input. Resetting to default (1/1/2000)." << std::endl;
            d.setDate(1, 1, 2000);
        }
        return in;
    }
};

int main() {
    std::cout << "--- TEST CASES ---\n";
    
    Date d1;
    std::cout << "Default constructor: " << d1 << "\n";
    
    Date d2(4, 10, 2014);
    std::cout << "Constructor with parameters: " << d2 << "\n";
    
    d2.setDate(5, 20, 2020);
    std::cout << "setDate() to valid date: " << d2 << "\n";
    
    d2.setDate(13, 45, 2018);
    d2.setDate(4, 31, 2000);
    d2.setDate(2, 29, 2009);
    
    Date d3(4, 18, 2014);
    std::cout << "Days between 4/10/2014 and 4/18/2014: " << (d3 - d2) << " days\n";
    
    Date d4(2, 2, 2006), d5(11, 10, 2003);
    std::cout << "Days between 2/2/2006 and 11/10/2003: " << (d4 - d5) << " days\n";
    
    Date leap(2, 29, 2008);
    --leap;
    std::cout << "Pre-decrement 2/29/2008: " << leap << "\n";
    ++leap;
    std::cout << "Pre-increment back: " << leap << "\n";
    leap--;
    std::cout << "Post-decrement 2/29/2008: " << leap << "\n";
    leap++;
    std::cout << "Post-increment back: " << leap << "\n";
    
    Date yearEnd(12, 31, 2024);
    yearEnd++;
    std::cout << "Post-increment 12/31/2024: " << yearEnd << "\n";
    yearEnd--;
    std::cout << "Post-decrement back: " << yearEnd << "\n";
    
    ++yearEnd;
    std::cout << "Pre-increment 12/31/2024: " << yearEnd << "\n";
    --yearEnd;
    std::cout << "Pre-decrement back: " << yearEnd << "\n";
    
    std::cout << "Enter a date (MM/DD/YYYY): ";
    Date inputDate;
    std::cin >> inputDate;
    std::cout << "You entered: " << inputDate << "\n";

    return 0;
}



   
   
   
   
